# Copy this file to .env and fill in the values.
# .env is git-ignored — never commit real credentials.

# PostgreSQL connection (used by devPostgres and prod profiles)
DB_URL=jdbc:postgresql://localhost:5432/webstore
DB_USERNAME=postgres
DB_PASSWORD=

# Public URL exposed by the app (used by application.yml → app.public.url)
APP_PUBLIC_URL=http://SEEYOURALB/webstore

# Aurora PostgreSQL on AWS RDS (used by the aws-rds profile — connects to the
# already-deployed dev-portfolio-webstore Aurora cluster). The DB security group
# only allows inbound from the ECS tasks' security group, so a local run needs
# an SSM/bastion port-forward tunnel to the cluster endpoint first.
# Look up the real values for the deployed stack:
#   aws cloudformation describe-stacks --stack-name yourcomponentstack-rds --query "Stacks[0].Outputs" --region us-east-1
#   aws secretsmanager get-secret-value --secret-id yourcomponentstack-db-secret --query SecretString --output text --region us-east-1
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

