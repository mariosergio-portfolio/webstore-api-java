# Copy this file to .env and fill in the values.
# .env is git-ignored — never commit real credentials.

# PostgreSQL connection (used by devPostgres and prod profiles)
DB_URL=jdbc:postgresql://localhost:5432/webstore
DB_USERNAME=postgres
DB_PASSWORD=

# Public URL exposed by the app (used by application.yml → app.public.url)
APP_PUBLIC_URL=http://dev-webstore-alb-1430553120.us-east-1.elb.amazonaws.com/
