# CREATE A NEW TASK DEFINITION VERSION (if needed)

aws ecs describe-task-definition `
  --task-definition dev-webstore-catalog-task:5 `
  --region us-east-1 `
  --query 'taskDefinition' > old-task-def.json

# strip fields register-task-definition doesn't accept
jq --arg IMAGE "$NEW_IMAGE" --arg NAME "$CONTAINER_NAME" `
  '.containerDefinitions |= map(if .name == $NAME then .image = $IMAGE else . end)
   | del(.taskDefinitionArn, .revision, .status, .requiresAttributes,
         .compatibilities, .registeredAt, .registeredBy)' `
  old-task-def.json > old-task-def-clean.json

aws ecs register-task-definition `
  --region us-east-1 `
  --cli-input-json file://old-task-def-clean.json

