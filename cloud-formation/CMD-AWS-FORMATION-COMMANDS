# [1/8] VPC (VPC, Subnets, Security Groups, etc.) - only needed once per product
aws cloudformation deploy `
  --stack-name dev-webstore-vpc `
  --template-file ./aws-vpc-stack.yml `
  --region us-east-1 `
  --capabilities CAPABILITY_NAMED_IAM CAPABILITY_AUTO_EXPAND `
  --parameter-overrides `
    Environment=dev `
    ProductName=webstore


# [2/8] ECS INFRA - PER PRODUCT (VPC, Subnets, Security Groups, ALB, Target Group, ECS Cluster, etc.)

# PowerShell: $p = Get-Content ./params-dev.json | ConvertFrom-Json
aws cloudformation deploy `
  --template-file ./aws-ecs-infra-stack.yml `
  --stack-name dev-webstore-ecs-infra `
  --capabilities CAPABILITY_NAMED_IAM CAPABILITY_AUTO_EXPAND `
  --region us-east-1 `
  --parameter-overrides `
    Environment=dev `
    ProductName=webstore `
    AwsAccountId=$($p.AwsAccountId)


# [3/8] BUILD/DEPLOYMENT per APP COMPONENT (CodeBuild project, ECR repository, etc.) - only needed once per component

# PowerShell: $p = Get-Content ./params-dev.json | ConvertFrom-Json
aws cloudformation deploy `
   --template-file ./aws-codebuild-stack.yml `
   --stack-name dev-webstore-catalog-codebuild `
   --capabilities CAPABILITY_NAMED_IAM `
   --region us-east-1 `
   --parameter-overrides `
       Environment=dev `
       ProductName=webstore `
       AwsAccountId=$($p.AwsAccountId) `
       AppServiceName=catalog `
       GitHubOwner=$($p.GitHubOwner) `
       GitHubRepo=$($p.GitHubRepo) `
       GitHubBranch=$($p.GitHubBranch) `
       GitHubConnectionArn=$($p.GitHubConnectionArn)


# [4/8] IAM per APP COMPONENT (ECS task role, execution role, etc.) - only needed once per component
aws cloudformation deploy `
  --stack-name dev-webstore-catalog-iam `
  --template-file ./aws-iam-stack.yml `
  --region us-east-1 `
  --capabilities CAPABILITY_NAMED_IAM CAPABILITY_AUTO_EXPAND `
  --parameter-overrides `
    Environment=dev `
    ProductName=webstore `
    AppServiceName=catalog


# [5/8] PUT SSM PARAMETER (IMAGE TAG) - per APP COMPONENT (ECS task definition reads the image tag from SSM Parameter Store)
aws ssm put-parameter `
  --name dev-webstore-catalog-imageTag `
  --value 1.0.0 `
  --type String `
  --region us-east-1 `
  # --overwrite `
  --tags Key=Environment,Value=dev `
             Key=ProductName,Value=webstore `
             Key=AppServiceName,Value=catalog `
             Key=Layer,Value=infrastructure



# [6/8] ECS SERVICES - per APP COMPONENT (ECS task definition, ECS service, ALB listener rule, etc.)

# NOTE: The ImageTag parameter is NO MORE REQUIRED as input for deploy aws-ecs-stack.
 The ECS task definition now reads the image tag from SSM Parameter Store.

# PowerShell: $p = Get-Content ./params-dev.json | ConvertFrom-Json
aws cloudformation deploy `
  --template-file ./aws-ecs-service-stack.yml `
  --stack-name dev-webstore-catalog-ecs-service `
  --capabilities CAPABILITY_NAMED_IAM CAPABILITY_AUTO_EXPAND `
  --region us-east-1 `
  --parameter-overrides `
    Environment=dev `
    ProductName=webstore `
    AppServiceName=catalog `
    ListenerRulePriority=10 `
    AwsAccountId=$($p.AwsAccountId)


# UPDATE (BEST OPTION INSTEAD "aws ecs describe-task-definition"):
 If your ECS resources (task definition, service, cluster) are defined
 in aws-ecs-stack.yml, the CloudFormation approach is better
 - and the manual register-task-definition approach becomes actively risky in that context.
#
aws cloudformation update-stack `
    --stack-name dev-webstore-catalog-ecs-service`
    --use-previous-template `
    --parameters `
      ParameterKey=ProductName,UsePreviousValue=true `
      ParameterKey=Environment,UsePreviousValue=true `
      ParameterKey=AppComponentName,UsePreviousValue=true `
      ParameterKey=ContainerPort,UsePreviousValue=true `
      ParameterKey=HealthCheckPath,UsePreviousValue=true `
      ParameterKey=HealthCheckIntervalSeconds,UsePreviousValue=true `
      ParameterKey=HealthCheckTimeoutSeconds,UsePreviousValue=true `
      ParameterKey=HealthyThresholdCount,UsePreviousValue=true `
      ParameterKey=UnhealthyThresholdCount,UsePreviousValue=true `
      ParameterKey=ListenerRulePriority,UsePreviousValue=true `
      ParameterKey=TaskCpu,UsePreviousValue=true `
      ParameterKey=TaskMemory,UsePreviousValue=true `
      ParameterKey=LogRetentionDays,UsePreviousValue=true `
      ParameterKey=DesiredCount,ParameterValue=3 `
    --region us-east-1


# [7/8] CI/CD PIPELINE TRIGGER - per APP COMPONENT (EventBridge -> Lambda -> ECS redeploy)
# After this stack is deployed every successful CodeBuild build automatically
# registers a new ECS task definition revision and force-redeploys the ECS service.
# No manual redeployment step needed.
#
# All resource names (CodeBuild project, ECR URI, ECS cluster/service/task family,
# container name, SSM parameter) are derived from ProductName + AppServiceName +
# Environment - no extra parameters required.

# PowerShell: $p = Get-Content ./params-dev.json | ConvertFrom-Json
aws cloudformation deploy `
  --template-file aws-pipeline-stack.yml `
  --stack-name dev-webstore-catalog-pipeline `
  --capabilities CAPABILITY_NAMED_IAM `
  --region us-east-1 `
  --parameter-overrides `
    Environment=dev `
    ProductName=webstore `
    AwsAccountId=$($p.AwsAccountId) `
    AppServiceName=catalog


# [8/8] VERIFY PIPELINE STACK DEPLOYED CORRECTLY
# Inspect Lambda logs after a build to confirm the auto-deploy fired:
aws logs tail /aws/lambda/dev-webstore-catalog-deploy-trigger --follow --region us-east-1

# Check the current deployed image tag in SSM:
aws ssm get-parameter `
  --name dev-webstore-catalog-imageTag `
  --region us-east-1 `
  --query "Parameter.Value" `
  --output text



UTILS: (Formation)

aws cloudformation delete-stack --stack-name dev-webstore-codebuild
aws cloudformation delete-stack --stack-name dev-webstore-ecs

aws cloudformation describe-stacks `
