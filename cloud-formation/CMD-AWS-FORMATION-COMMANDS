------------- OPERATION - REDEPLOYMENT --------------

### Step 1 - Build & push new image to ECR (via CodeBuild)

  aws codebuild start-build `
    --project-name "$StackPrefix-$AppServiceName-codebuild" `
    --region us-east-1 `
    --environment-variables-override name=IMAGE_TAG,value=1.0.0,type=PLAINTEXT
    # --source-version develop


  # NOT REQUIRED: Get the build ID from the start-build output, then:
  aws codebuild batch-get-builds `
    --ids <build-id> `
    --region us-east-1 `
    --query "builds[0].{status:buildStatus,phase:currentPhase}"


### Step 2 - Force ECS to redeploy with the new image

Option A - force new deployment (fastest, no CloudFormation needed):

# RUN THIS COMMAND AFTER A SUCCESSFUL BUILD (Step 1) TO FORCE ECS TO REDEPLOY THE SERVICE WITH THE NEW IMAGE:
aws ecs update-service `
    --cluster "$StackPrefix-cluster" `
    --service "$StackPrefix-$AppServiceName-service" `
    --desired-count 3 `
    --force-new-deployment `
    --region us-east-1


# RESTORE ONE SPECIFIC TASK DEFINITION VERSION (if needed)
  aws ecs update-service `
    --cluster "$StackPrefix-cluster" `
    --service "$StackPrefix-$AppServiceName-service" `
    --force-new-deployment `
    --region us-east-1 `
    --task-definition "$StackPrefix-task:5"  #OPTIONAL: specify the task definition version to use (latest is default)


UTILS: (Operations)

aws ecr describe-images `
  --repository-name "$StackPrefix-repo" `
  --region us-east-1 `
  --query 'sort_by(imageDetails,& imagePushedAt)[*].[imageTags[0],imagePushedAt]' `
  --output table


aws ecs list-task-definition-families --region us-east-1

aws ecs list-task-definitions `
  --family-prefix "$StackPrefix-$AppServiceName-task" `
  --region us-east-1 `
  --sort DESC

aws ecs describe-task-definition `
  --task-definition "$StackPrefix-$AppServiceName-task:5" `
  --query 'taskDefinition.containerDefinitions[*].image'

--------------------------------------------------------
# CREATE A NEW TASK DEFINITION VERSION (if needed)

aws ecs describe-task-definition `
  --task-definition "$StackPrefix-$AppServiceName-task:5" `
  --region us-east-1 `
  --query 'taskDefinition' > old-task-def.json

# strip fields register-task-definition doesn't accept
jq --arg IMAGE "$NEW_IMAGE" --arg NAME "$CONTAINER_NAME" `
  '.containerDefinitions |= map(if .name == $NAME then .image = $IMAGE else . end)
   | del(.taskDefinitionArn, .revision, .status, .requiresAttributes,
         .compatibilities, .registeredAt, .registeredBy)' `
  old-task-def.json > old-task-def-clean.json

aws ecs register-task-definition `
  --region us-east-1 `
  --cli-input-json file://old-task-def-clean.json

